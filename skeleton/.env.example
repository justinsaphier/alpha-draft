# Copy this file to .env for local development and fill in real values.
# .env is git-ignored. Spring does not read .env by itself: export these variables in
# your shell or IDE run configuration before starting the app.
SUPABASE_DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your-database-password

# Secret used to sign sign-in tokens. Use a random string of at least 32 characters.
JWT_SECRET=replace-with-a-random-string-of-32-plus-characters
