# Copy this file to .env (in this skeleton folder) and fill in real values. .env is git-ignored.
# The app reads .env automatically when started from this folder (./mvnw spring-boot:run).
#
# Database: Supabase dashboard -> Connect -> "Session pooler" (works on IPv4 networks; the
# "Direct connection" host is IPv6-only and often fails on home/campus Wi-Fi).
# Supabase shows  postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Split it like this - add "jdbc:" and move the user and password into their own lines:
SUPABASE_DB_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# Secret used to sign sign-in tokens. Use a random string of at least 32 characters.
JWT_SECRET=replace-with-a-random-string-of-32-plus-characters

# The admin account, created on startup (or promoted if it already signed up as a player).
# Password must be at least 8 characters. Every other sign-up is a PLAYER.
ADMIN_EMAIL=admin@alphadraft.test
ADMIN_PASSWORD=change-me-admin-password

# Twelve Data API key (free at twelvedata.com) for closing prices. Used by the price job and the
# admin's "Refresh closing prices". Optional: without it the job is skipped with a warning.
TWELVE_DATA_API_KEY=your-twelve-data-api-key
